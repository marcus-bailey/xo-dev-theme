{% doc %}
  @prompt
    I want a full width, horizontal Menu which includes an image and text for each menu item.  Both the image and text should be clickable and link to another location on the site.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-menu-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-horizontal-menu__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-horizontal-menu__container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-horizontal-menu__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    transition: transform 0.2s ease;
    min-width: {{ block.settings.item_min_width }}px;
    flex-shrink: 0;
  }

  .ai-horizontal-menu__item-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    color: {{ block.settings.text_hover_color }};
  }

  .ai-horizontal-menu__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin-bottom: {{ block.settings.text_spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-horizontal-menu__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-horizontal-menu__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-horizontal-menu__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-horizontal-menu__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-align: center;
    line-height: 1.2;
    margin: 0;
  }

  .ai-horizontal-menu__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size:14px;
  }

  @media screen and (max-width: 749px) {
    .ai-horizontal-menu__container-{{ ai_gen_id }} {
      justify-content: flex-start;
      gap: {{ block.settings.item_spacing | times: 0.75 }}px;
    }

    .ai-horizontal-menu__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-horizontal-menu__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-horizontal-menu__item-{{ ai_gen_id }} {
      min-width: {{ block.settings.item_min_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<nav class="ai-horizontal-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-horizontal-menu__container-{{ ai_gen_id }}">
    {% assign has_items = false %}
    
    {% for i in (1..8) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_text_key = 'item_' | append: i | append: '_text'
        assign item_link_key = 'item_' | append: i | append: '_link'

        assign item_enabled = block.settings[item_enabled_key]
        assign item_image = block.settings[item_image_key]
        assign item_text = block.settings[item_text_key]
        assign item_link = block.settings[item_link_key]%}

      {% if item_enabled %}
        {% assign has_items = true %}
        <a 
          href="{{ item_link | default: '#' }}" 
          class="ai-horizontal-menu__item-{{ ai_gen_id }}"
          {% if item_text != blank %}aria-label="{{ item_text | escape }}"{% endif %}>
          <div class="ai-horizontal-menu__image-wrapper-{{ ai_gen_id }}">
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 200 }}"
                alt="{{ item_image.alt | escape }}"
                class="ai-horizontal-menu__image-{{ ai_gen_id }}"loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-horizontal-menu__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          {% if item_text != blank %}
            <span class="ai-horizontal-menu__text-{{ ai_gen_id }}">{{ item_text }}</span>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}

    {% unless has_items %}
      <div class="ai-horizontal-menu__empty-state-{{ ai_gen_id }}">
        Enable menu items and add images and text to get started
      </div>
    {% endunless %}
  </div>
</nav>

