{% doc %}
  @prompt
    A full width, horizontal menu which has full sized product cards (up to 5).  Each card links to a collection (or other location on the site), The menu should be scrollable, right and left, so a user could see additional menu items.  It should support several cards horizontally.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-menu-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-menu-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
    position: relative;
  }

  .ai-product-menu-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-product-menu-scroll-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
    margin-bottom: -10px;
  }

  .ai-product-menu-scroll-container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-menu-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-product-menu-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
  }

  .ai-product-menu-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-product-menu-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-menu-card-{{ ai_gen_id }}:hover .ai-product-menu-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-menu-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-menu-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-menu-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-menu-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-menu-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-product-menu-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }}.visible {
    opacity: 1;
    visibility: visible;
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }}--left {
    left: -{{ block.settings.nav_button_size | divided_by: 2 }}px;
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }}--right {
    right: -{{ block.settings.nav_button_size | divided_by: 2 }}px;
  }

  .ai-product-menu-nav-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_button_size | times: 0.4 }}px;
    height: {{ block.settings.nav_button_size | times: 0.4 }}px;
    color: {{ block.settings.nav_button_icon_color }};
  }

  .ai-product-menu-scroll-indicator-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .ai-product-menu-scroll-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.scroll_indicator_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-product-menu-scroll-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 990px) {
    .ai-product-menu-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_tablet }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.nav_button_size | times: 0.9 }}px;
      height: {{ block.settings.nav_button_size | times: 0.9 }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }}--left {
      left: -{{ block.settings.nav_button_size | times: 0.9 | divided_by: 2 }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }}--right {
      right: -{{ block.settings.nav_button_size | times: 0.9 | divided_by: 2 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-menu-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
    }

    .ai-product-menu-scroll-container-{{ ai_gen_id }} {
      gap: {{ block.settings.card_spacing | times: 0.75 }}px;
    }

    .ai-product-menu-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_content_padding | times: 0.75 }}px;
    }

    .ai-product-menu-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-product-menu-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.nav_button_size | times: 0.8 }}px;
      height: {{ block.settings.nav_button_size | times: 0.8 }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }}--left {
      left: -{{ block.settings.nav_button_size | times: 0.8 | divided_by: 2 }}px;
    }

    .ai-product-menu-nav-button-{{ ai_gen_id }}--right {
      right: -{{ block.settings.nav_button_size | times: 0.8 | divided_by: 2 }}px;
    }
  }
{% endstyle %}

<scrollable-product-menu-{{ ai_gen_id }}
  class="ai-product-menu-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-menu-container-{{ ai_gen_id }}">
    <div class="ai-product-menu-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-product-menu-nav-button-{{ ai_gen_id }} ai-product-menu-nav-button-{{ ai_gen_id }}--left"
        aria-label="Scroll left"
        data-direction="left"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="ai-product-menu-scroll-container-{{ ai_gen_id }}" data-scroll-container>
        {% for i in (1..10) %}
          {% liquid
            assign card_enabled_key = 'card_' | append: i | append: '_enabled'
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_title_key = 'card_' | append: i | append: '_title'
            assign card_description_key = 'card_' | append: i | append: '_description'
            assign card_link_key = 'card_' | append: i | append: '_link'

            assign card_enabled = block.settings[card_enabled_key]
            assign card_image = block.settings[card_image_key]
            assign card_title = block.settings[card_title_key]
            assign card_description = block.settings[card_description_key]
            assign card_link = block.settings[card_link_key]%}

          {% if card_enabled %}
            <a
              href="{{ card_link | default: '#' }}"
              class="ai-product-menu-card-{{ ai_gen_id }}"
              {% unless card_link %}onclick="return false;"{% endunless %}
            >
              <div class="ai-product-menu-image-wrapper-{{ ai_gen_id }}">
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 600}}"
                    alt="{{ card_image.alt | escape }}"
                    class="ai-product-menu-image-{{ ai_gen_id }}"loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                  >
                {% else %}
                  <div class="ai-product-menu-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}<div class="ai-product-menu-empty-state-{{ ai_gen_id }}">
                      Add an image for card {{ i }}
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="ai-product-menu-content-{{ ai_gen_id }}">
                {% if card_title != blank %}
                  <h3 class="ai-product-menu-title-{{ ai_gen_id }}">{{ card_title }}</h3>
                {% else %}
                  <h3 class="ai-product-menu-title-{{ ai_gen_id }}" style="color: #999; font-style: italic;">Card {{ i }} title</h3>
                {% endif %}

                {% if card_description != blank %}
                  <p class="ai-product-menu-description-{{ ai_gen_id }}">{{ card_description }}</p>
                {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-product-menu-nav-button-{{ ai_gen_id }} ai-product-menu-nav-button-{{ ai_gen_id }}--right"
        aria-label="Scroll right"
        data-direction="right"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    {% if block.settings.show_scroll_indicators %}
      <div class="ai-product-menu-scroll-indicator-{{ ai_gen_id }}" data-scroll-indicators></div>
    {% endif %}
  </div>
</scrollable-product-menu-{{ ai_gen_id }}><script>
  (function() {
    class ScrollableProductMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = null;
        this.leftButton = null;
        this.rightButton = null;
        this.scrollIndicators = null;
        this.scrollAmount = 0;
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('[data-scroll-container]');
        this.leftButton = this.querySelector('[data-direction="left"]');
        this.rightButton = this.querySelector('[data-direction="right"]');
        this.scrollIndicators = this.querySelector('[data-scroll-indicators]');

        if (!this.scrollContainer) return;

        this.calculateScrollAmount();
        this.setupEventListeners();
        this.updateNavigationButtons();
        this.setupScrollIndicators();

        window.addEventListener('resize', () => {
          this.calculateScrollAmount();
          this.updateNavigationButtons();
          this.setupScrollIndicators();
        });
      }

      calculateScrollAmount() {
        const cardWidth = {{ block.settings.card_width }};
        const cardSpacing = {{ block.settings.card_spacing }};
        
        if (window.innerWidth <= 749) {
          this.scrollAmount = {{ block.settings.card_width_mobile }} + {{ block.settings.card_spacing | times: 0.75 }};
        } else if (window.innerWidth <= 990) {
          this.scrollAmount = {{ block.settings.card_width_tablet }} + {{ block.settings.card_spacing }};
        } else {
          this.scrollAmount = cardWidth + cardSpacing;
        }
      }

      setupEventListeners() {
        this.leftButton.addEventListener('click', () => this.scroll('left'));
        this.rightButton.addEventListener('click', () => this.scroll('right'));

        this.scrollContainer.addEventListener('scroll', () => {
          this.updateNavigationButtons();
          this.updateScrollIndicators();
        });

        let isScrolling = false;
        this.scrollContainer.addEventListener('touchstart', () => {
          isScrolling = true;
        });

        this.scrollContainer.addEventListener('touchend', () => {
          setTimeout(() => {
            isScrolling = false;
          }, 100);
        });

        this.scrollContainer.addEventListener('scroll', () => {
          if (!isScrolling) {
            this.updateNavigationButtons();
            this.updateScrollIndicators();
          }
        });
      }

      scroll(direction) {
        const scrollLeft = this.scrollContainer.scrollLeft;
        const newScrollLeft = direction === 'left' 
          ? scrollLeft - this.scrollAmount 
          : scrollLeft + this.scrollAmount;

        this.scrollContainer.scrollTo({
          left: newScrollLeft,
          behavior: 'smooth'
        });
      }

      updateNavigationButtons() {
        const scrollLeft = this.scrollContainer.scrollLeft;
        const maxScrollLeft = this.scrollContainer.scrollWidth - this.scrollContainer.clientWidth;

        this.leftButton.classList.toggle('visible', scrollLeft > 0);
        this.rightButton.classList.toggle('visible', scrollLeft < maxScrollLeft -1);
      }

      setupScrollIndicators() {
        if (!this.scrollIndicators) return;

        const containerWidth = this.scrollContainer.clientWidth;
        const totalWidth = this.scrollContainer.scrollWidth;
        const numDots = Math.ceil(totalWidth / containerWidth);

        this.scrollIndicators.innerHTML = '';
        
        if (numDots <= 1) return;

        for (let i = 0; i < numDots; i++) {
          const dot = document.createElement('div');
          dot.className = 'ai-product-menu-scroll-dot-{{ ai_gen_id }}';
          this.scrollIndicators.appendChild(dot);
        }

        this.updateScrollIndicators();
      }

      updateScrollIndicators() {
        if (!this.scrollIndicators) return;

        const dots = this.scrollIndicators.querySelectorAll('.ai-product-menu-scroll-dot-{{ ai_gen_id }}');
        if (dots.length === 0) return;

        const scrollLeft = this.scrollContainer.scrollLeft;
        const containerWidth = this.scrollContainer.clientWidth;
        const currentIndex = Math.round(scrollLeft / containerWidth);

        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === currentIndex);
        });
      }
    }

    customElements.define('scrollable-product-menu-{{ ai_gen_id }}', ScrollableProductMenu{{ ai_gen_id }});
  })();
</script>

