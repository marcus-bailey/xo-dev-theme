{% doc %}
  @prompt
    A horizontal menu which can be used to link to other related pages.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-menu-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.border_thickness > 0 %}
      border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-horizontal-menu__list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.item_spacing }}px;
    margin:0;
    padding: 0;
    list-style: none;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
  }

  .ai-horizontal-menu__item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-horizontal-menu__link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    border-radius: {{ block.settings.link_border_radius }}px;
    transition: all0.3s ease;
    {% if block.settings.link_background_color !='rgba(0,0,0,0)' %}
      background-color: {{ block.settings.link_background_color }};
    {% endif %}
    {% if block.settings.link_border_thickness > 0 %}
      border: {{ block.settings.link_border_thickness }}px solid {{ block.settings.link_border_color }};
    {% endif %}}

  .ai-horizontal-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    {% if block.settings.link_hover_background_color != 'rgba(0,0,0,0)' %}
      background-color: {{ block.settings.link_hover_background_color }};
    {% endif %}
    {% if block.settings.link_border_thickness > 0 %}
      border-color: {{ block.settings.link_hover_border_color }};
    {% endif %}
    transform: translateY(-1px);
  }

  .ai-horizontal-menu__separator-{{ ai_gen_id }} {
    width: 1px;
    height: {{ block.settings.separator_height }}px;
    background-color: {{ block.settings.separator_color }};
    margin: 0;}

  @media screen and (max-width: 749px) {
    .ai-horizontal-menu__list-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing_mobile }}px;
      {% if block.settings.mobile_layout == 'stack' %}
        flex-direction: column;
        align-items: stretch;
      {% endif %}
    }

    .ai-horizontal-menu__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;{% if block.settings.mobile_layout == 'stack' %}
        text-align: center;
      {% endif %}
    }

    .ai-horizontal-menu__separator-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        display: none;
      {% endif %}
    }
  }
{% endstyle %}<nav class="ai-horizontal-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-horizontal-menu__list-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign link_text_key = 'link_' | append: i | append: '_text'
        assign link_url_key = 'link_' | append: i | append: '_url'
        assign link_text = block.settings[link_text_key]
        assign link_url = block.settings[link_url_key]
      %}
      
      {% if link_text != blank %}
        <li class="ai-horizontal-menu__item-{{ ai_gen_id }}">
          <a 
            href="{% if link_url != blank %}{{ link_url }}{% else %}#{% endif %}" 
            class="ai-horizontal-menu__link-{{ ai_gen_id }}"
          >
            {{ link_text }}
          </a>
        </li>
        
        {% if block.settings.show_separators and forloop.last == false %}
          {% assign next_index = i | plus: 1 %}
          {% assign next_link_text_key = 'link_' | append: next_index | append: '_text' %}
          {% assign next_link_text = block.settings[next_link_text_key] %}
          {% if next_link_text != blank %}
            <li class="ai-horizontal-menu__separator-{{ ai_gen_id }}"></li>
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
  </ul>
</nav>

