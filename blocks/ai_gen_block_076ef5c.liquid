{% doc %}
  @prompt
    Fix the Scrollable product menu section to display at full width. The menu should span the entire width of the page container.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scrollable-menu-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-scrollable-menu-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100vw;
    margin: 0;
    padding: 0;
  }

  .ai-scrollable-menu-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-scrollable-menu-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-scrollable-menu-list-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: max-content;
  }

  .ai-scrollable-menu-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: {{ block.settings.item_width }}px;
  }

  .ai-scrollable-menu-link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    transition: transform 0.2s ease;
    width: 100%;
  }

  .ai-scrollable-menu-link-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    color: {{ block.settings.text_hover_color }};
  }

  .ai-scrollable-menu-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: 8px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-scrollable-menu-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-scrollable-menu-image-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-scrollable-menu-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    margin: 0;
    line-height: 1.2;}

  .ai-scrollable-menu-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    margin: 4px 0 0;
  }

  .ai-scrollable-menu-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-scrollable-menu-item-{{ ai_gen_id }} {
      width: {{ block.settings.item_width | times: 0.8 }}px;
    }
    
    .ai-scrollable-menu-image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;height: {{ block.settings.image_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-scrollable-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scrollable-menu-container-{{ ai_gen_id }}">
    {% if block.settings.selected_products.size > 0 %}
      <div class="ai-scrollable-menu-wrapper-{{ ai_gen_id }}">
        <ul class="ai-scrollable-menu-list-{{ ai_gen_id }}">
          {% for product in block.settings.selected_products %}
            <li class="ai-scrollable-menu-item-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-scrollable-menu-link-{{ ai_gen_id }}">
                <div class="ai-scrollable-menu-image-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 200 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <h3 class="ai-scrollable-menu-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                {% if block.settings.show_price %}
                  <div class="ai-scrollable-menu-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% else %}
      <div class="ai-scrollable-menu-empty-state-{{ ai_gen_id }}">
        Next, select products to display in the scrollable menu
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Scrollable product menu",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "selected_products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product prices",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "item_width",
      "min": 120,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Item width",
      "default": 150
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Item spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 60,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Image size",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Price font size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text hover color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Scrollable product menu"
    }
  ],
  "tag": null
}
{% endschema %}